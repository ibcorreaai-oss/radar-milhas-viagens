# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Stripe (ver MONETIZATION.md) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preço mensal de cada plano (Price recorrente, intervalo "month")
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CONSULTOR=
# Preço anual de cada plano (Price recorrente, intervalo "year") — opcional:
# sem preencher, o toggle "Anual" em /assinatura simplesmente não gera
# checkout pra esse plano (mesmo tratamento de "stripe_nao_configurado" que
# já existe pro mensal).
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_CONSULTOR_ANNUAL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Resend (e-mail) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=Radar Milhas <alertas@radarmilhas.com>

# === Observabilidade (ver OBSERVABILITY.md) ===
# E-mail que recebe alerta crítico (falha de pagamento, falha sistêmica de
# autenticação, erro não tratado). Reaproveita o Resend acima — sem isso
# configurado, alertas críticos só ficam no log estruturado, sem e-mail.
OPS_ALERT_EMAIL=

# === n8n — alerta crítico → Telegram (ver AUTOMATIONS.md) ===
# URL do webhook do workflow n8n "Radar Milhas & Viagens — Alerta
# Operacional → Telegram" + o segredo que vai no header X-Radar-Milhas-Secret
# (nome do header é fixo no código, só o valor é segredo). Sem os dois, esse
# canal só fica registrado no log estruturado, igual ao e-mail acima.
N8N_ALERT_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_SECRET=

# === WhatsApp (Evolution API ou Z-API — escolha um) ===
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
WHATSAPP_PROVIDER=evolution

# === IA consultora ===
# AI_PROVIDER controla qual IA o Trip Builder e o Concierge usam (ver
# lib/ai/provider.ts). Deixe em branco ou "none" para zero custo garantido
# (cai em fallback determinístico, sem IA nenhuma). "groq" usa a Groq (free
# tier) -- exige GROQ_API_KEY + GROQ_MODEL preenchidos. "anthropic" é PAGO,
# só entra em uso com esta variável setada explicitamente para ele.
AI_PROVIDER=
GROQ_API_KEY=
# Confirme o model id atual em https://console.groq.com/docs/models ou num
# bot que já use Groq (modelos são descontinuados com frequência).
GROQ_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === WhatsApp de suporte (botão "Falar no WhatsApp" da home — ver GROWTH.md) ===
# Só o número, formato internacional sem símbolos (ex.: 5585999998888).
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=

# === Analytics / pixels de anúncio (ver GROWTH.md — todos opcionais, cada
# script só carrega se a variável correspondente estiver preenchida) ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_TWITTER_PIXEL_ID=
# Twitter/X não tem eventos padrão com nome fixo — cada conversão precisa de
# um "Event ID" (tw-xxxxx-yyyyy) criado na conta de anúncios (Twitter Ads →
# Conversion Tracking). Sem preencher, o pixel carrega mas nenhuma conversão
# é reportada (achado em revisão adversarial, ver lib/analytics.ts).
NEXT_PUBLIC_TWITTER_EVENT_ID_LEAD=
NEXT_PUBLIC_TWITTER_EVENT_ID_SIGNUP=
NEXT_PUBLIC_TWITTER_EVENT_ID_SUBSCRIBE=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# === Central de Treinamentos / vídeo (ver TRAINING.md — só se for usar o
# provider Cloudflare Stream numa aula; YouTube/Vimeo/Bunny/Supabase/URL
# direta não precisam de nada aqui) ===
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=

# === Cron ===
CRON_SECRET=

# === Provider de voo real — SerpApi Google Flights (ver
# lib/providers/serpapi-flight-provider.ts) ===
# Plano Free da SerpApi: 250 buscas/mês, sem cartão cadastrado. Preenchendo
# esta chave, getFlightProvider() passa a usar dados reais de mercado
# automaticamente (fallback pro mock em qualquer erro/estouro de cota, nunca
# quebra a busca). Pegue a chave em https://serpapi.com/manage-api-key.
SERPAPI_KEY=
# Teto mensal próprio de segurança (deixa margem antes do limite real de 250
# do plano Free) — opcional, default 200 se vazio.
SERPAPI_MONTHLY_CAP=

# === Providers de voo/hotel (fora do MVP — deixar vazio) ===
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SKYSCANNER_API_KEY=
DUFFEL_ACCESS_TOKEN=
BOOKING_API_KEY=
